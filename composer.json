{
    "name": "wapplersystems/address",
    "type": "typo3-cms-extension",
    "description": "Address extension. Code is based on news extension from Georg Ringer.",
    "keywords": ["TYPO3", "extension", "address", "addresses"],
    "homepage": "https://github.com/WapplerSystems/address",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "homepage": "https://wappler.systems",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/WapplerSystems/address",
        "issues": "https://github.com/WapplerSystems/address/issues"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.0",
        "wapplersystems/tag": "^14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\Address\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WapplerSystems\\Address\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "address"
        }
    }
}